rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // Solución SaaS: Lectura pública de evidencias para visualización en reportes y navegador
    // Esto asegura que <img> con URLs de descarga funcionen siempre.
    match /companies/{companyId}/workOrders/{workOrderId}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    
    match /companies/{companyId}/branding/{fileName} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Regla por defecto
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}