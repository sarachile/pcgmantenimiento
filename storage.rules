rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // Solución SaaS: Lectura pública de evidencias para visualización en reportes y emails
    // Escritura restringida a personal autenticado
    match /companies/{companyId}/workOrders/{workOrderId}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    
    match /companies/{companyId}/branding/{fileName} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Regla por defecto: Lectura permitida para activos públicos, escritura privada
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}