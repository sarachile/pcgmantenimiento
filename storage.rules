rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // Solución SaaS: Permitir lectura pública para reportes y escritura para firmas de clientes
    // La seguridad reside en que el ID de la OT actúa como un token secreto
    match /companies/{companyId}/workOrders/{workOrderId}/{fileName} {
      allow read: if true;
      allow write: if true; 
    }
    
    match /companies/{companyId}/branding/{fileName} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Regla por defecto para el resto del bucket
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
