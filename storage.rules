rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    /**
     * PCGMANTENIMIENTO STORAGE RULES - Production Reliability Edition
     * Permite lectura pública para que los reportes y portales siempre muestren las fotos.
     * Permite escritura a cualquier usuario autenticado (Técnicos y Admins).
     */
    match /{allPaths=**} {
      // Lectura abierta para evitar errores en reportes PDF y Portal QR
      allow read: if true;
      
      // Escritura permitida para personal de la empresa logueado
      allow write: if request.auth != null;
    }
  }
}