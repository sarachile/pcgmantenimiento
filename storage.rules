rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    /**
     * PCGMANTENIMIENTO STORAGE RULES - Production Ready
     * Lectura pública para que reportes PDF y portal QR muestren las fotos.
     * Escritura para cualquier usuario de la empresa (Técnicos y Admins).
     */
    match /{allPaths=**} {
      // Lectura universal para evitar fallos visuales en reportes y portal externo
      allow read: if true;
      
      // Escritura permitida para personal con cuenta activa
      allow write: if request.auth != null;
    }
  }
}