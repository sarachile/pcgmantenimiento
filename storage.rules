rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    /**
     * PCGMANTENIMIENTO STORAGE RULES
     * Permite a cualquier usuario autenticado subir y leer evidencias.
     * Esto soluciona los errores de "Permission Denied" para el técnico y admin.
     */
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}