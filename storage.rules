rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // Ruta para evidencias y firmas de OTs
    // Se permite lectura pública para facilitar la visualización en reportes y emails sin tokens complejos
    match /companies/{companyId}/workOrders/{workOrderId}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    
    // Ruta para logotipos de empresa
    match /companies/{companyId}/branding/{fileName} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Por defecto, lectura pública para evitar errores de <img> y escritura solo para autenticados
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
