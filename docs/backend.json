
{
  "entities": {
    "Company": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Company",
      "type": "object",
      "description": "Entidad principal que representa a una empresa cliente (tenant). Aísla todos los datos operativos.",
      "properties": {
        "id": {
          "type": "string",
          "description": "ID único de la empresa."
        },
        "name": {
          "type": "string",
          "description": "Nombre legal de la empresa."
        },
        "rut": {
          "type": "string",
          "description": "Rol Único Tributario (Chile)."
        },
        "address": {
          "type": "string",
          "description": "Dirección física de la casa matriz."
        },
        "isActive": {
          "type": "boolean",
          "description": "Estado de la cuenta de la empresa (bloquea acceso total si es false)."
        },
        "currentPlan": {
          "type": "string",
          "enum": ["free", "pro", "enterprise"],
          "description": "Plan actual de suscripción."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "name", "rut", "isActive", "currentPlan", "createdAt"]
    },
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Perfil de usuario con rol y vinculación a empresa.",
      "properties": {
        "id": {
          "type": "string",
          "description": "UID de Firebase Auth."
        },
        "companyId": {
          "type": "string",
          "description": "Referencia a la empresa a la que pertenece. Nulo si es superadmin."
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "firstName": {
          "type": "string"
        },
        "lastName": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": ["superadmin", "companyAdmin", "supervisor", "tecnico", "reviewer"],
          "description": "Rol jerárquico dentro de la plataforma o empresa."
        },
        "isActive": {
          "type": "boolean",
          "description": "Permite deshabilitar el acceso individual del usuario."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdBy": {
          "type": "string",
          "description": "UID del usuario que creó este perfil (Auditoría)."
        }
      },
      "required": ["id", "email", "role", "isActive", "createdAt"]
    },
    "Subscription": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Subscription",
      "type": "object",
      "description": "Historial y estado de facturación de la empresa.",
      "properties": {
        "id": {
          "type": "string"
        },
        "companyId": {
          "type": "string"
        },
        "plan": {
          "type": "string",
          "enum": ["free", "pro", "enterprise"]
        },
        "status": {
          "type": "string",
          "enum": ["active", "past_due", "canceled", "trialing"]
        },
        "startDate": {
          "type": "string",
          "format": "date-time"
        },
        "endDate": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "companyId", "plan", "status", "startDate"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/companies/{companyId}",
        "definition": {
          "entityName": "Company",
          "schema": { "$ref": "#/backend/entities/Company" },
          "description": "Colección raíz de empresas."
        }
      },
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": { "$ref": "#/backend/entities/User" },
          "description": "Mapeo global de perfiles para login y redirección."
        }
      },
      {
        "path": "/companies/{companyId}/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": { "$ref": "#/backend/entities/User" },
          "description": "Subcolección de usuarios por empresa para reglas de seguridad eficientes."
        }
      },
      {
        "path": "/companies/{companyId}/subscriptions/{subId}",
        "definition": {
          "entityName": "Subscription",
          "schema": { "$ref": "#/backend/entities/Subscription" },
          "description": "Historial de suscripciones y planes de la empresa."
        }
      }
    ]
  }
}
