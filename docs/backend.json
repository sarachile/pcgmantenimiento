
{
  "entities": {
    "Company": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Company",
      "type": "object",
      "description": "Tenant documents with plan-based limits.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "rut": { "type": "string" },
        "address": { "type": "string" },
        "logoUrl": { "type": "string" },
        "currentPlan": { "type": "string", "enum": ["simple", "business", "enterprise"] },
        "subscriptionStatus": { "type": "string", "enum": ["active", "past_due", "canceled"] },
        "isActive": { "type": "boolean" },
        "metrics": {
          "type": "object",
          "properties": {
            "usedStorageMb": { "type": "number" },
            "monthlyOrdersCount": { "type": "number" },
            "currentMonth": { "type": "string" }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "currentPlan", "isActive", "createdAt"]
    },
    "User": {
      "title": "User",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["companyAdmin", "supervisor", "tecnico", "reviewer", "superadmin"] },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "WorkOrder": {
      "title": "WorkOrder",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "clientId": { "type": "string" },
        "status": { "type": "string" },
        "description": { "type": "string" },
        "checklist": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "task": { "type": "string" },
              "completed": { "type": "boolean" },
              "evidenceUrl": { "type": "string" }
            }
          }
        },
        "clientApprovalCode": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "structure": [
      { "path": "/users/{userId}", "definition": { "entityName": "User", "description": "Global user profiles." } },
      { "path": "/companies/{companyId}", "definition": { "entityName": "Company", "description": "Main tenant config." } },
      { "path": "/companies/{companyId}/workOrders/{workOrderId}", "definition": { "entityName": "WorkOrder", "description": "Operational orders." } }
    ]
  }
}
