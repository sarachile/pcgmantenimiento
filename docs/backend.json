
{
  "entities": {
    "Company": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Company",
      "type": "object",
      "description": "Entidad principal que representa a una empresa cliente (tenant).",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "rut": { "type": "string" },
        "address": { "type": "string" },
        "isActive": { "type": "boolean" },
        "currentPlan": { "type": "string", "enum": ["free", "pro", "enterprise"] },
        "subscriptionStatus": { "type": "string", "enum": ["active", "past_due", "canceled"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "rut", "isActive", "currentPlan", "createdAt"]
    },
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Perfil de usuario con rol y vinculación a empresa.",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "role": { "type": "string", "enum": ["superadmin", "companyAdmin", "supervisor", "tecnico", "reviewer"] },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "role", "isActive", "createdAt"]
    },
    "Subscription": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Subscription",
      "description": "Historial de planes y estados de suscripción por empresa.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "plan": { "type": "string", "enum": ["free", "pro", "enterprise"] },
        "status": { "type": "string", "enum": ["active", "past_due", "canceled"] },
        "startDate": { "type": "string", "format": "date-time" },
        "endDate": { "type": "string", "format": "date-time" },
        "billingCycle": { "type": "string", "enum": ["monthly", "yearly"] }
      },
      "required": ["id", "plan", "status", "startDate"]
    },
    "UsageStats": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UsageStats",
      "description": "Contadores de uso para control de límites de plan.",
      "type": "object",
      "properties": {
        "activeUsersCount": { "type": "number" },
        "workOrdersCreatedMonth": { "type": "number" },
        "invoicesIssuedMonth": { "type": "number" },
        "lastResetDate": { "type": "string", "format": "date-time" }
      },
      "required": ["activeUsersCount", "workOrdersCreatedMonth", "invoicesIssuedMonth"]
    },
    "Payment": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Payment",
      "description": "Registro de pagos de suscripción.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string", "default": "CLP" },
        "status": { "type": "string", "enum": ["paid", "pending", "failed"] },
        "paymentMethod": { "type": "string" },
        "transactionId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "amount", "status", "createdAt"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/companies/{companyId}": {
      "schema": { "$ref": "#/backend/entities/Company" },
      "description": "Documentos de empresa."
    },
    "/companies/{companyId}/subscriptions/{subId}": {
      "schema": { "$ref": "#/backend/entities/Subscription" },
      "description": "Historial de suscripciones."
    },
    "/companies/{companyId}/stats/usage": {
      "schema": { "$ref": "#/backend/entities/UsageStats" },
      "description": "Contadores de uso de la empresa."
    },
    "/companies/{companyId}/payments/{paymentId}": {
      "schema": { "$ref": "#/backend/entities/Payment" },
      "description": "Historial de pagos."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/backend/entities/User" },
      "description": "Perfiles de usuario globales."
    }
  }
}
