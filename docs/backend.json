
{
  "entities": {
    "Company": {
      "title": "Company",
      "type": "object",
      "description": "Empresa cliente (tenant).",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "rut": { "type": "string" },
        "address": { "type": "string" },
        "isActive": { "type": "boolean" },
        "currentPlan": { "type": "string", "enum": ["free", "pro", "enterprise"] },
        "subscriptionStatus": { "type": "string", "enum": ["active", "past_due", "canceled"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "rut", "isActive", "currentPlan", "createdAt"]
    },
    "Client": {
      "title": "Client",
      "type": "object",
      "description": "Cliente final de la empresa.",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "name": { "type": "string" },
        "rut": { "type": "string" },
        "address": { "type": "string" },
        "contactName": { "type": "string" },
        "contactEmail": { "type": "string", "format": "email" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "companyId", "name", "rut", "createdAt"]
    },
    "User": {
      "title": "User",
      "type": "object",
      "description": "Perfil de usuario con rol.",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["superadmin", "companyAdmin", "supervisor", "tecnico", "reviewer"] },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "role", "active", "createdAt"]
    },
    "WorkOrder": {
      "title": "WorkOrder",
      "type": "object",
      "description": "Orden de trabajo de mantenimiento.",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "clientId": { "type": "string" },
        "assetId": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["creada", "asignada", "ejecutada", "en revision", "aprobada", "rechazada"] },
        "assignedToUserId": { "type": "string" },
        "reviewerRequired": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "executedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "companyId", "clientId", "status", "createdAt"]
    },
    "Asset": {
      "title": "Asset",
      "type": "object",
      "description": "Equipo o activo sujeto a mantenimiento.",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "location": { "type": "string" },
        "status": { "type": "string", "enum": ["activo", "inactivo", "en mantenimiento"] },
        "lastMaintenanceAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "companyId", "name", "code", "status"]
    },
    "SparePart": {
      "title": "SparePart",
      "type": "object",
      "description": "Repuesto o insumo de inventario.",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "name": { "type": "string" },
        "sku": { "type": "string" },
        "stockActual": { "type": "number" },
        "stockMinimo": { "type": "number" },
        "unitPrice": { "type": "number" }
      },
      "required": ["id", "companyId", "name", "stockActual"]
    },
    "PartUsage": {
      "title": "PartUsage",
      "type": "object",
      "description": "Registro de uso de repuestos en una OT.",
      "properties": {
        "id": { "type": "string" },
        "workOrderId": { "type": "string" },
        "partId": { "type": "string" },
        "quantity": { "type": "number" },
        "usedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "workOrderId", "partId", "quantity"]
    },
    "Invoice": {
      "title": "Invoice",
      "type": "object",
      "description": "Factura electrónica.",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "clientId": { "type": "string" },
        "workOrderId": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["pendiente", "enviado", "error", "aceptado_sii"] },
        "simpleApiId": { "type": "string" },
        "issuedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "companyId", "clientId", "workOrderId", "amount", "status", "issuedAt"]
    },
    "DigitalLogbookEntry": {
      "title": "DigitalLogbookEntry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "workOrderId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "eventType": { "type": "string" },
        "eventDetails": { "type": "string" },
        "actorUserId": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/companies/{companyId}": {
      "schema": { "$ref": "#/backend/entities/Company" },
      "description": "Documentos de empresa."
    },
    "/companies/{companyId}/clients/{clientId}": {
      "schema": { "$ref": "#/backend/entities/Client" },
      "description": "Clientes de la empresa."
    },
    "/companies/{companyId}/assets/{assetId}": {
      "schema": { "$ref": "#/backend/entities/Asset" },
      "description": "Activos de la empresa."
    },
    "/companies/{companyId}/spareParts/{partId}": {
      "schema": { "$ref": "#/backend/entities/SparePart" },
      "description": "Repuestos en inventario."
    },
    "/companies/{companyId}/workOrders/{workOrderId}": {
      "schema": { "$ref": "#/backend/entities/WorkOrder" },
      "description": "Órdenes de trabajo."
    },
    "/companies/{companyId}/workOrders/{workOrderId}/partUsages/{usageId}": {
      "schema": { "$ref": "#/backend/entities/PartUsage" },
      "description": "Uso de repuestos por OT."
    },
    "/companies/{companyId}/workOrders/{workOrderId}/invoices/{invoiceId}": {
      "schema": { "$ref": "#/backend/entities/Invoice" },
      "description": "Facturas emitidas."
    },
    "/companies/{companyId}/workOrders/{workOrderId}/digitalLogbookEntries/{entryId}": {
      "schema": { "$ref": "#/backend/entities/DigitalLogbookEntry" },
      "description": "Libro digital."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/backend/entities/User" },
      "description": "Perfiles de usuario."
    }
  }
}
