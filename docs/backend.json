
{
  "entities": {
    "Company": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Company",
      "type": "object",
      "description": "Entidad principal que representa a una empresa cliente (tenant).",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "rut": { "type": "string" },
        "address": { "type": "string" },
        "isActive": { "type": "boolean" },
        "currentPlan": { "type": "string", "enum": ["free", "pro", "enterprise"] },
        "subscriptionStatus": { "type": "string", "enum": ["active", "past_due", "canceled"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "rut", "isActive", "currentPlan", "createdAt"]
    },
    "Client": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Client",
      "type": "object",
      "description": "Cliente final al que la empresa presta servicios de mantención.",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "name": { "type": "string" },
        "rut": { "type": "string" },
        "address": { "type": "string" },
        "contactName": { "type": "string" },
        "contactEmail": { "type": "string", "format": "email" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "companyId", "name", "rut", "createdAt"]
    },
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Perfil de usuario con rol y vinculación a empresa.",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "role": { "type": "string", "enum": ["superadmin", "companyAdmin", "supervisor", "tecnico", "reviewer"] },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "role", "isActive", "createdAt"]
    },
    "WorkOrder": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "WorkOrder",
      "type": "object",
      "description": "Orden de trabajo vinculada a una empresa, un cliente y un activo opcional.",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "clientId": { "type": "string" },
        "assetId": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["creada", "asignada", "ejecutada", "en revision", "aprobada", "rechazada"] },
        "assignedToUserId": { "type": "string" },
        "reviewerId": { "type": "string" },
        "reviewerRequired": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "executedAt": { "type": "string", "format": "date-time" },
        "evidenceUrls": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "companyId", "clientId", "status", "createdAt"]
    },
    "Invoice": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Invoice",
      "type": "object",
      "description": "Factura electrónica emitida mediante SimpleAPI vinculada a una OT.",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "clientId": { "type": "string" },
        "workOrderId": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["pendiente", "enviado", "error", "aceptado_sii"] },
        "simpleApiId": { "type": "string" },
        "pdfUrl": { "type": "string" },
        "xmlUrl": { "type": "string" },
        "issuedBy": { "type": "string" },
        "issuedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "companyId", "clientId", "workOrderId", "amount", "status", "issuedAt"]
    },
    "DigitalLogbookEntry": {
      "title": "DigitalLogbookEntry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "workOrderId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "eventType": { "type": "string" },
        "eventDetails": { "type": "string" },
        "actorUserId": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/companies/{companyId}": {
      "schema": { "$ref": "#/backend/entities/Company" },
      "description": "Documentos de empresa."
    },
    "/companies/{companyId}/clients/{clientId}": {
      "schema": { "$ref": "#/backend/entities/Client" },
      "description": "Clientes de la empresa."
    },
    "/companies/{companyId}/workOrders/{workOrderId}": {
      "schema": { "$ref": "#/backend/entities/WorkOrder" },
      "description": "Órdenes de trabajo de la empresa."
    },
    "/companies/{companyId}/workOrders/{workOrderId}/invoices/{invoiceId}": {
      "schema": { "$ref": "#/backend/entities/Invoice" },
      "description": "Facturas emitidas para una OT específica."
    },
    "/companies/{companyId}/workOrders/{workOrderId}/digitalLogbookEntries/{entryId}": {
      "schema": { "$ref": "#/backend/entities/DigitalLogbookEntry" },
      "description": "Entradas del libro digital por OT."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/backend/entities/User" },
      "description": "Perfiles de usuario globales."
    }
  }
}
