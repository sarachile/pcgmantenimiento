
{
  "entities": {
    "Company": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Company",
      "type": "object",
      "description": "Represents a single tenant or enterprise within the multi-company SaaS platform, with completely isolated data.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "legalName": { "type": "string" },
        "rut": { "type": "string" },
        "address": { "type": "string" },
        "contactEmail": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "isActive": { "type": "boolean" },
        "logoUrl": { "type": "string" },
        "currentPlan": { "type": "string", "enum": ["free", "pro", "enterprise"] },
        "subscriptionStatus": { "type": "string", "enum": ["active", "past_due", "canceled"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "isActive", "createdAt"]
    },
    "User": {
      "title": "User",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["companyAdmin", "supervisor", "tecnico", "reviewer", "superadmin"] },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "companyId", "email", "role", "active"]
    },
    "Team": {
      "title": "Team",
      "type": "object",
      "description": "A squad or brigade of staff members for bulk assignment.",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "name": { "type": "string" },
        "memberIds": { "type": "array", "items": { "type": "string" } },
        "leaderId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "companyId", "name", "memberIds"]
    },
    "WorkOrder": {
      "title": "WorkOrder",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "clientId": { "type": "string" },
        "assetId": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["creada", "asignada", "ejecutada", "en revision", "pendiente cliente", "aprobada", "rechazada"] },
        "assignedToStaffIds": { "type": "array", "items": { "type": "string" } },
        "assignedTeamId": { "type": "string" },
        "createdByUserId": { "type": "string" },
        "reviewerRequired": { "type": "boolean" },
        "evaluationRequired": { "type": "boolean" },
        "approvalPin": { "type": "string" },
        "scheduledDate": { "type": "string", "format": "date-time" },
        "durationDays": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "companyId", "clientId", "status", "createdAt"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "structure": [
      { "path": "/users/{userId}", "definition": { "entityName": "User", "description": "Global user profiles." } },
      { "path": "/companies/{companyId}", "definition": { "entityName": "Company", "description": "Tenant documents." } },
      { "path": "/companies/{companyId}/teams/{teamId}", "definition": { "entityName": "Team", "description": "Operational squads." } },
      { "path": "/companies/{companyId}/workOrders/{workOrderId}", "definition": { "entityName": "WorkOrder", "description": "Maintenance orders." } }
    ]
  }
}
