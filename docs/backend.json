
{
  "entities": {
    "Company": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Company",
      "type": "object",
      "description": "Represents a single tenant or enterprise within the multi-company SaaS platform, with completely isolated data.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "legalName": { "type": "string" },
        "rut": { "type": "string" },
        "address": { "type": "string" },
        "contactEmail": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "isActive": { "type": "boolean" },
        "logoUrl": { "type": "string" },
        "currentPlan": { "type": "string", "enum": ["free", "pro", "enterprise"] },
        "subscriptionStatus": { "type": "string", "enum": ["active", "past_due", "canceled"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "isActive", "createdAt"]
    },
    "User": {
      "title": "User",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["companyAdmin", "supervisor", "tecnico", "reviewer", "superadmin"] },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "companyId", "email", "role", "active"]
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "companyId": { "type": "string" },
        "userName": { "type": "string" },
        "companyName": { "type": "string" },
        "subject": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "in_progress", "resolved", "closed"] },
        "priority": { "type": "string", "enum": ["low", "medium", "high", "urgent"] },
        "category": { "type": "string", "enum": ["technical", "billing", "feature", "other"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "companyId", "status", "priority"]
    },
    "WorkOrder": {
      "title": "WorkOrder",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "clientId": { "type": "string" },
        "assetId": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["creada", "asignada", "ejecutada", "en revision", "pendiente cliente", "aprobada", "rechazada"] },
        "assignedToStaffIds": { "type": "array", "items": { "type": "string" } },
        "createdByUserId": { "type": "string" },
        "reviewerRequired": { "type": "boolean" },
        "evaluationRequired": { "type": "boolean" },
        "approvalPin": { "type": "string" },
        "scheduledDate": { "type": "string", "format": "date-time" },
        "durationDays": { "type": "number" },
        "clientApprovalCode": { "type": "string" },
        "technicianApprovalCode": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "companyId", "clientId", "status", "createdAt"]
    },
    "SparePart": {
      "title": "SparePart",
      "type": "object",
      "description": "Represents an item in the company's inventory.",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "name": { "type": "string" },
        "sku": { "type": "string" },
        "stockActual": { "type": "number" },
        "stockMinimo": { "type": "number" },
        "unitPrice": { "type": "number" }
      },
      "required": ["id", "companyId", "name", "sku", "stockActual"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "structure": [
      { "path": "/users/{userId}", "definition": { "entityName": "User", "description": "Global user profiles." } },
      { "path": "/supportTickets/{ticketId}", "definition": { "entityName": "SupportTicket", "description": "Support request tickets." } },
      { "path": "/supportTickets/{ticketId}/messages/{messageId}", "definition": { "entityName": "object", "description": "Chat messages within a ticket." } },
      { "path": "/companies/{companyId}", "definition": { "entityName": "Company", "description": "Tenant documents." } },
      { "path": "/companies/{companyId}/spareParts/{partId}", "definition": { "entityName": "SparePart", "description": "Company inventory items." } },
      { "path": "/companies/{companyId}/workOrders/{workOrderId}", "definition": { "entityName": "WorkOrder", "description": "Maintenance orders." } }
    ]
  }
}
