
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    function isSignedIn() { return request.auth != null; }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/superAdmins/$(request.auth.uid));
    }

    function isCompanyMember(companyId) {
      let userData = getUserData();
      return isSignedIn() && (userData.companyId == companyId || isSuperAdmin());
    }

    function hasRole(roles) {
      let userData = getUserData();
      return isSignedIn() && (userData.role in roles || isSuperAdmin());
    }

    // --- RULES ---

    // Global user profiles for lookup
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
    }

    match /superAdmins/{userId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /companies/{companyId} {
      allow get: if isCompanyMember(companyId);
      allow list: if isSuperAdmin();
      allow create, update: if isSuperAdmin();

      match /users/{userId} {
        allow read: if isCompanyMember(companyId);
        allow write: if isSuperAdmin() || (hasRole(['companyAdmin']) && request.auth.uid == userId);
      }

      match /workOrders/{workOrderId} {
        allow get, list: if isCompanyMember(companyId);
        
        // Logical rule for Reviewer
        allow create: if isCompanyMember(companyId) && hasRole(['companyAdmin', 'supervisor', 'tecnico']);
        
        allow update: if isCompanyMember(companyId) && (
          // Supervisors and Admins can update anything
          hasRole(['companyAdmin', 'supervisor']) ||
          // Technicians can update OTs assigned to them or if they created them
          (hasRole(['tecnico']) && (resource.data.assignedTo == request.auth.uid || resource.data.createdBy == request.auth.uid)) ||
          // Reviewers can only update if they are the reviewer (usually via subcollection review)
          hasRole(['reviewer'])
        );

        match /digitalLogbookEntries/{entryId} {
          allow read: if isCompanyMember(companyId);
          allow create: if isCompanyMember(companyId);
          allow update, delete: if false; // IMMUTABILITY
        }

        match /reviews/{reviewId} {
          allow read: if isCompanyMember(companyId);
          allow create, update: if isCompanyMember(companyId) && hasRole(['reviewer', 'supervisor', 'companyAdmin']);
        }
      }
    }
  }
}
