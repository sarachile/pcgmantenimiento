rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * PCGMANTENIMIENTO SECURITY RULES - Zero Friction Production Edition
     * Prioridad: Disponibilidad de Servicio > Restricción.
     */

    // 1. SOPORTE Y COMUNICACIÓN (Global)
    // Permite que cualquier usuario autenticado gestione tickets.
    match /supportTickets/{ticketId} {
      allow read, write: if request.auth != null;
      
      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }

    // 2. PORTAL PÚBLICO (QR) Y VISUALIZACIÓN DE CLIENTE
    // Permitimos lectura pública en rutas de solo consulta para que el QR nunca falle.
    match /companies/{companyId} {
      allow read: if true;
      allow write: if request.auth != null;
      
      match /clients/{clientId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
      
      match /assets/{assetId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
      
      match /workOrders/{otId} {
        // Lectura y actualización pública para permitir firmas QR y estados sin login forzado
        allow read, update: if true;
        
        match /digitalLogbookEntries/{entryId} {
          allow read, create: if true;
        }
        match /partUsages/{usageId} {
          allow read: if true;
        }
      }

      match /evaluations/{evalId} {
        allow read, create: if true;
      }

      match /staff/{staffId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
      
      match /spareParts/{partId} {
        allow read, write: if request.auth != null;
      }
      
      match /teams/{teamId} {
        allow read, write: if request.auth != null;
      }
    }

    // 3. PERFIL DE USUARIO Y ADMINS
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }
    
    match /platform_admins/{adminId} {
      allow read: if request.auth != null;
    }

    // 4. REGLA MAESTRA DE RESPALDO
    // Para cualquier otra colección, si el usuario está logueado, tiene acceso.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}