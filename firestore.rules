
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- FUNCIONES HELPER ---
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isSuperAdmin() {
      // Validación ultra-segura para el administrador maestro por email o registro en colección
      return isSignedIn() && (
        request.auth.token.email == 'control@pcgoperacion.com' ||
        exists(/databases/$(database)/documents/superAdmins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin')
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isCompanyMember(companyId) {
      if (!isSignedIn()) return false;
      if (isSuperAdmin()) return true;
      
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(userPath) && get(userPath).data.companyId == companyId;
    }

    // --- REGLAS DE COLECCIONES ---

    // Colección para la extensión Trigger Email
    match /mail/{mailId} {
      // El administrador maestro siempre puede crear correos
      // Otros usuarios pueden crear correos si están autenticados (flujos del sistema)
      allow create: if isSignedIn();
      // Solo el superadmin puede leer el historial de envíos para auditoría
      allow read, write: if isSuperAdmin();
    }

    match /superAdmins/{userId} {
      allow create: if isOwner(userId) && request.auth.token.email == 'control@pcgoperacion.com';
      allow read: if isSignedIn() && (isOwner(userId) || isSuperAdmin());
      allow update, delete: if isSuperAdmin();
    }

    match /users/{userId} {
      allow create: if isOwner(userId);
      allow read: if isSignedIn();
      allow update: if isOwner(userId) || isSuperAdmin();
    }

    match /companies/{companyId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (
        isSuperAdmin() || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId)
      );
      
      allow update: if isSignedIn() && (isSuperAdmin() || isCompanyMember(companyId));
      allow list: if isSuperAdmin();

      match /{allPaths=**} {
        allow read, write: if isSignedIn() && (isSuperAdmin() || isCompanyMember(companyId));
      }
    }
  }
}
