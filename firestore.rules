
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- FUNCIONES HELPER ---
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isSuperAdmin() {
      if (!isSignedIn()) return false;
      return exists(/databases/$(database)/documents/superAdmins/$(request.auth.uid)) || 
             (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin');
    }

    function isCompanyMember(companyId) {
      if (!isSignedIn()) return false;
      if (isSuperAdmin()) return true;
      // Solo intentamos obtener el documento si existe, para evitar crashes en las reglas
      if (!exists(/databases/$(database)/documents/users/$(request.auth.uid))) return false;
      let userData = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return userData.companyId == companyId;
    }

    function hasRole(companyId, roles) {
      if (!isSignedIn()) return false;
      if (isSuperAdmin()) return true;
      if (!exists(/databases/$(database)/documents/users/$(request.auth.uid))) return false;
      let userData = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return userData.role in roles && userData.companyId == companyId;
    }

    // --- REGLAS ---

    match /superAdmins/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin() || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && isCompanyMember(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId)));
      allow list: if isSignedIn() && (isSuperAdmin() || (request.query.limit <= 100)); // Permitir listado limitado para auditoría o miembros
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
    }

    match /companies/{companyId} {
      allow get: if isSignedIn() && (isCompanyMember(companyId) || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create: if isSignedIn(); 
      allow update: if isSuperAdmin() || hasRole(companyId, ['companyAdmin']);

      match /clients/{clientId} {
        allow read: if isCompanyMember(companyId);
        allow write: if hasRole(companyId, ['companyAdmin', 'supervisor']);
      }

      match /assets/{assetId} {
        allow read: if isCompanyMember(companyId);
        allow create: if hasRole(companyId, ['companyAdmin', 'supervisor']);
        allow update: if hasRole(companyId, ['companyAdmin', 'supervisor', 'tecnico']);
        allow delete: if hasRole(companyId, ['companyAdmin']);
      }

      match /spareParts/{partId} {
        allow read: if isCompanyMember(companyId);
        allow create, update, delete: if hasRole(companyId, ['companyAdmin', 'supervisor']);
      }

      match /workOrders/{workOrderId} {
        allow list: if isCompanyMember(companyId);
        allow get: if isCompanyMember(companyId);
        allow create: if hasRole(companyId, ['companyAdmin', 'supervisor']);
        allow update: if isCompanyMember(companyId);

        match /partUsages/{usageId} {
          allow read: if isCompanyMember(companyId);
          allow create: if hasRole(companyId, ['companyAdmin', 'supervisor', 'tecnico']);
        }

        match /digitalLogbookEntries/{entryId} {
          allow read: if isCompanyMember(companyId);
          allow create: if isCompanyMember(companyId);
        }

        match /invoices/{invoiceId} {
          allow read: if isCompanyMember(companyId);
          allow create: if hasRole(companyId, ['companyAdmin', 'supervisor']);
        }
      }
    }
  }
}
