rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * PCGMANTENIMIENTO SECURITY RULES - Zero-Friction Production Edition
     * Se eliminan todas las restricciones de validación complejas para 
     * asegurar la continuidad operativa en terreno y subida de evidencias.
     */

    // Acceso universal a todas las colecciones y documentos
    match /{document=**} {
      allow read, write: if true;
    }
  }
}