
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * PCGMANTENIMIENTO SECURITY RULES - SaaS Edition
     * Optimizadas para Onboarding y Trazabilidad Industrial
     */

    // --- Funciones de Ayuda ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isPlatformAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/platform_admins/$(request.auth.uid));
    }

    function getUserData() {
      if (!isSignedIn()) {
        return null;
      }
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data : null;
    }

    function isCompanyMember(companyId) {
      let userData = getUserData();
      return isSignedIn() && (isPlatformAdmin() || (userData != null && userData.companyId == companyId));
    }

    function hasRole(role) {
      let userData = getUserData();
      return isSignedIn() && (isPlatformAdmin() || (userData != null && userData.role == role));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- REGLAS DE ACCESO PÚBLICO (PARA INVITACIONES Y PORTALES) ---
    
    match /companies/{companyId} {
      // Permitir que cualquier persona con el link vea el nombre/branding de la empresa
      allow get: if true;
      allow list: if isSignedIn();

      match /staff/{staffId} {
        // Vital para el proceso de invitación por WhatsApp
        allow get: if true; 
        allow list: if isCompanyMember(companyId);
        allow write: if isCompanyMember(companyId) || isSignedIn();
      }

      match /clients/{clientId} {
        // Permitir que el portal de autogestión valide al cliente
        allow get: if true;
        allow list: if isCompanyMember(companyId);
        allow write: if isCompanyMember(companyId);
      }

      match /workOrders/{workOrderId} {
        // El portal de aprobación y solicitud es público mediante ID largo (token)
        allow get: if true;
        allow list: if isCompanyMember(companyId);
        allow create: if isCompanyMember(companyId) || (request.resource.data.status == 'solicitada');
        allow update: if isCompanyMember(companyId) || isSignedIn() || (resource.data.status == 'pendiente cliente');
        
        match /digitalLogbookEntries/{entryId} {
          allow read, write: if isCompanyMember(companyId) || isSignedIn() || true; // Permitir log desde portal
        }
        
        match /partUsages/{usageId} {
          allow read, write: if isCompanyMember(companyId);
        }
      }
      
      match /assets/{assetId} {
        allow get: if true; // Para ver equipo en portal de aprobación
        allow list, write: if isCompanyMember(companyId);
      }

      match /evaluations/{evalId} {
        allow create: if true; // Permitir feedback desde portal externo
        allow read, write: if isCompanyMember(companyId);
      }
      
      // Resto de subcolecciones protegidas
      match /{allSub=**} {
        allow read, write: if isCompanyMember(companyId);
      }
    }

    // --- REGLAS DE USUARIOS ---

    match /users/{userId} {
      // Necesario para verificar perfiles durante login y registro
      allow get: if true;
      // Permitir búsqueda por RUT durante el login técnico sin sesión iniciada
      allow list: if true; 
      allow create: if true; 
      allow update: if isOwner(userId) || isPlatformAdmin();
      allow delete: if isPlatformAdmin();
    }

    match /platform_admins/{adminId} {
      allow get: if isSignedIn();
      allow list: if isPlatformAdmin();
    }

    match /supportTickets/{ticketId} {
      allow get, update: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();

      match /messages/{messageId} {
        allow read, write: if isSignedIn();
      }
    }

    match /mail/{mailId} {
      allow read, write: if isSignedIn();
    }
  }
}
