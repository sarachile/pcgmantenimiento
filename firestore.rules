
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * PCGMANTENIMIENTO SECURITY RULES
     * Soporte SaaS y Validación Externa
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isPlatformAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/platform_admins/$(request.auth.uid));
    }

    function getUserData() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data : null;
    }

    function isCompanyMember(companyId) {
      let userData = getUserData();
      return isSignedIn() && (isPlatformAdmin() || (userData != null && userData.companyId == companyId));
    }

    function hasRole(role) {
      let userData = getUserData();
      return isSignedIn() && (isPlatformAdmin() || (userData != null && userData.role == role));
    }

    function isAtLeastSupervisor(companyId) {
      let userData = getUserData();
      return isCompanyMember(companyId) && (userData.role == 'supervisor' || userData.role == 'companyAdmin');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get: if isOwner(userId) || isPlatformAdmin();
      allow list: if isPlatformAdmin() || (isSignedIn() && getUserData().companyId != null);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isPlatformAdmin();
      allow delete: if isPlatformAdmin();
    }

    match /platform_admins/{adminId} {
      allow get: if isSignedIn();
      allow list: if isPlatformAdmin();
    }

    match /companies/{companyId} {
      allow get: if true;
      allow list: if isPlatformAdmin() || isSignedIn();
      allow create: if isPlatformAdmin();
      allow update: if isPlatformAdmin() || (isCompanyMember(companyId) && hasRole('companyAdmin'));
      allow delete: if isPlatformAdmin();

      match /staff/{staffId} {
        allow read, write: if isCompanyMember(companyId);
      }

      match /teams/{teamId} {
        allow read, write: if isCompanyMember(companyId);
      }

      match /clients/{clientId} {
        allow get: if true;
        allow list: if isCompanyMember(companyId);
        allow write: if isAtLeastSupervisor(companyId);
      }

      match /assets/{assetId} {
        allow get: if true;
        allow list: if isCompanyMember(companyId);
        allow write: if isCompanyMember(companyId);
      }

      match /spareParts/{partId} {
        allow read, write: if isCompanyMember(companyId);
      }

      match /evaluations/{evalId} {
        // Solo supervisores y admins ven feedback
        allow read: if isAtLeastSupervisor(companyId);
        allow create: if true; 
      }

      match /billingDocuments/{docId} {
        // Solo supervisores y admins ven facturación
        allow read, write: if isAtLeastSupervisor(companyId);
      }

      match /workOrders/{workOrderId} {
        allow get: if true; 
        allow list: if isCompanyMember(companyId);
        allow create: if isCompanyMember(companyId);
        allow update: if isCompanyMember(companyId) || (resource.data.status == 'pendiente cliente'); 
        allow delete: if isAtLeastSupervisor(companyId);

        // Subcolecciones críticas
        match /digitalLogbookEntries/{entryId} {
          allow read, write: if isCompanyMember(companyId);
        }
        
        match /partUsages/{usageId} {
          allow read, write: if isCompanyMember(companyId);
        }
      }
    }

    match /supportTickets/{ticketId} {
      allow get: if isSignedIn() && (isPlatformAdmin() || resource.data.userId == request.auth.uid || isAtLeastSupervisor(resource.data.companyId));
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (isPlatformAdmin() || resource.data.userId == request.auth.uid || isAtLeastSupervisor(resource.data.companyId));

      match /messages/{messageId} {
        allow read, write: if isSignedIn();
      }
    }

    match /mail/{mailId} {
      allow read, write: if isPlatformAdmin() || isSignedIn();
    }
  }
}
