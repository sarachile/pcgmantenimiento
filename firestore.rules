rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. SOPORTE TÉCNICO
    // Permite a usuarios autenticados gestionar sus propios tickets
    match /supportTickets/{ticketId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null && (
        resource.data.userId == request.auth.uid || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin'
      );
      
      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }

    // 2. OPERACIÓN EMPRESARIAL Y PORTAL QR (Apertura Total solicitada)
    // Se habilita acceso total para asegurar que técnicos y clientes (QR) operen sin bloqueos
    match /companies/{companyId} {
      allow read, write: if true;

      // Abre todas las subcolecciones: staff, workOrders, clients, assets, spareParts, teams, evaluations
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // 3. PERFILES DE USUARIO Y PERSONAL
    match /users/{userId} {
      allow read, write: if true;
    }

    // 4. SISTEMA DE CORREOS
    match /mail/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}