
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // 🔧 HELPERS
    // =========================

    function isSignedIn() {
      return request.auth != null;
    }

    function userDocRef() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userExists() {
      return exists(userDocRef());
    }

    function getUserData() {
      return userExists() ? get(userDocRef()).data : null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'control@pcgoperacion.com' ||
        exists(/databases/$(database)/documents/superAdmins/$(request.auth.uid)) ||
        (userExists() && getUserData().role == 'superadmin')
      );
    }

    function isCompanyMember(companyId) {
      return isSignedIn() &&
        (
          isSuperAdmin() || 
          (userExists() && getUserData().companyId == companyId)
        );
    }

    function hasRole(companyId, roles) {
      return isSignedIn() &&
        (
          isSuperAdmin() ||
          (userExists() && getUserData().companyId == companyId && getUserData().role in roles)
        );
    }

    // =========================
    // 📧 MAIL (LOGS DE SERVER ACTIONS)
    // =========================

    match /mail/{mailId} {
      allow read: if isSuperAdmin();
      allow create, update: if isSignedIn() && (isSuperAdmin() || getUserData().role == 'companyAdmin');
      allow delete: if false;
    }

    // =========================
    // 👤 USERS
    // =========================

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      
      // Permitir listar para validar límites durante el registro (obligatorio para el flujo signup)
      allow list: if true; 

      allow create: if isSignedIn();
      allow update: if isSignedIn() &&
        (
          request.auth.uid == userId ||
          isSuperAdmin()
        );
      allow delete: if isSuperAdmin();
    }

    match /superAdmins/{userId} {
      allow read, write: if isSuperAdmin();
    }

    // =========================
    // 🏢 COMPANIES
    // =========================

    match /companies/{companyId} {
      // Permitir 'get' para validar el código de vinculación durante el registro sin estar logueado aún
      allow get: if true; 
      
      allow list: if isSuperAdmin();
      allow create, update, delete: if isSuperAdmin();

      // ---------- CLIENTS ----------
      match /clients/{clientId} {
        allow read: if isCompanyMember(companyId);
        allow write: if hasRole(companyId, ['companyAdmin', 'supervisor']);
      }

      // ---------- ASSETS ----------
      match /assets/{assetId} {
        allow read: if isCompanyMember(companyId);
        allow create: if hasRole(companyId, ['companyAdmin', 'supervisor']);
        allow update: if hasRole(companyId, ['companyAdmin', 'supervisor', 'tecnico']);
        allow delete: if hasRole(companyId, ['companyAdmin']);
      }

      // ---------- SPARE PARTS ----------
      match /spareParts/{partId} {
        allow read: if isCompanyMember(companyId);
        allow create, update, delete: if hasRole(companyId, ['companyAdmin', 'supervisor']);
      }

      // ---------- WORK ORDERS ----------
      match /workOrders/{workOrderId} {
        allow list, get: if isCompanyMember(companyId);
        allow create: if hasRole(companyId, ['companyAdmin', 'supervisor', 'tecnico']);
        allow update: if hasRole(companyId, ['companyAdmin', 'supervisor', 'tecnico']);
        allow delete: if hasRole(companyId, ['companyAdmin']);

        // ---- PART USAGES ----
        match /partUsages/{usageId} {
          allow read: if isCompanyMember(companyId);
          allow create: if hasRole(companyId, ['companyAdmin', 'supervisor', 'tecnico']);
        }

        // ---- LOGBOOK ----
        match /digitalLogbookEntries/{entryId} {
          allow read: if isCompanyMember(companyId);
          allow create: if isCompanyMember(companyId);
        }

        // ---- INVOICES ----
        match /invoices/{invoiceId} {
          allow read: if isCompanyMember(companyId);
          allow create: if hasRole(companyId, ['companyAdmin', 'supervisor']);
        }
      }
    }

    // =========================
    // 🔒 DEFAULT DENY
    // =========================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
