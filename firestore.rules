
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- FUNCIONES HELPER ---
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isSuperAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/superAdmins/$(request.auth.uid)) || 
        getUserData().role == 'superadmin'
      );
    }

    function isCompanyMember(companyId) {
      return isSignedIn() && (getUserData().companyId == companyId || isSuperAdmin());
    }

    function hasRole(companyId, roles) {
      return isSignedIn() && (getUserData().role in roles || isSuperAdmin());
    }

    // --- REGLAS ---

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin() || isCompanyMember(resource.data.companyId));
      allow list: if isSignedIn() && (isSuperAdmin() || (request.query.filters != null && request.query.filters.companyId != null && isCompanyMember(request.query.filters.companyId[0])));
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
    }

    match /companies/{companyId} {
      allow get: if isCompanyMember(companyId);
      allow list: if isSuperAdmin();
      allow create, update: if isSuperAdmin();

      match /clients/{clientId} {
        allow read: if isCompanyMember(companyId);
        allow write: if hasRole(companyId, ['companyAdmin', 'supervisor']);
      }

      match /assets/{assetId} {
        allow read: if isCompanyMember(companyId);
        allow create: if hasRole(companyId, ['companyAdmin', 'supervisor']);
        allow update: if hasRole(companyId, ['companyAdmin', 'supervisor', 'tecnico']);
        allow delete: if hasRole(companyId, ['companyAdmin']);
      }

      match /spareParts/{partId} {
        allow read: if isCompanyMember(companyId);
        allow create, update, delete: if hasRole(companyId, ['companyAdmin', 'supervisor']);
      }

      match /workOrders/{workOrderId} {
        allow list: if isCompanyMember(companyId);
        allow get: if isCompanyMember(companyId);
        allow create: if hasRole(companyId, ['companyAdmin', 'supervisor']);
        allow update: if isCompanyMember(companyId);

        match /partUsages/{usageId} {
          allow read: if isCompanyMember(companyId);
          allow create: if hasRole(companyId, ['companyAdmin', 'supervisor', 'tecnico']);
        }

        match /digitalLogbookEntries/{entryId} {
          allow read: if isCompanyMember(companyId);
          allow create: if isCompanyMember(companyId);
        }

        match /invoices/{invoiceId} {
          allow read: if isCompanyMember(companyId);
          allow create: if hasRole(companyId, ['companyAdmin', 'supervisor']);
        }
      }
    }
  }
}
