rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * PCGMANTENIMIENTO SECURITY RULES - Production Stability Edition
     * Prioridad: Soporte -> Portal Público -> Resto del Sistema.
     */

    // 1. SOPORTE Y COMUNICACIÓN (Prioridad Máxima)
    // Permite que cualquier usuario autenticado (Técnico, Admin o Superadmin)
    // gestione sus tickets y vea los del sistema.
    match /supportTickets/{ticketId} {
      allow read, write: if request.auth != null;
      
      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }

    // 2. EXCEPCIÓN PORTAL CLIENTE: Lectura pública para aprobación QR
    // Esto permite que el portal funcione para mandantes externos no logueados.
    match /companies/{companyId}/workOrders/{otId} {
      allow read, update: if true;
      
      match /digitalLogbookEntries/{entryId} {
        allow read, create: if true;
      }
      match /partUsages/{usageId} {
        allow read: if true;
      }
    }
    
    match /companies/{companyId}/clients/{clientId} {
      allow read: if true;
    }
    
    match /companies/{companyId}/assets/{assetId} {
      allow read: if true;
    }

    match /companies/{companyId}/evaluations/{evalId} {
      allow create: if true;
    }

    match /companies/{companyId}/staff/{staffId} {
      allow read: if true;
    }

    // 3. REGLA MAESTRA DE SEGURIDAD
    // Para el resto del sistema (empresas, usuarios, inventario), se requiere estar logueado.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}