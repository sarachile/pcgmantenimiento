rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * PCGMANTENIMIENTO SECURITY RULES - Secure Edition
     * Solo permite lectura y escritura a usuarios que han iniciado sesión.
     * Esto protege contra bots y curiosos externos mientras mantiene la fluidez para el equipo.
     */
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}