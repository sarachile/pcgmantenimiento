
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * PCGMANTENIMIENTO SECURITY RULES - SaaS Edition
     * MAX FLEXIBILITY FOR EXTERNAL PORTALS & ONBOARDING
     */

    // --- Funciones de Ayuda ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isPlatformAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/platform_admins/$(request.auth.uid));
    }

    function isCompanyMember(companyId) {
      return isPlatformAdmin() || (
        isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId
      );
    }

    // --- REGLAS DE ACCESO PÚBLICO (PARA INVITACIONES Y PORTALES) ---
    
    match /companies/{companyId} {
      // Lectura pública total para branding en portales e invitaciones
      allow get: if true;
      allow list: if true;

      match /staff/{staffId} {
        // Permitir que el técnico lea su invitación y actualice su estado
        allow get, write: if true; 
        allow list: if true;
      }

      match /clients/{clientId} {
        // El portal de aprobación necesita leer los datos del cliente para validar el PIN
        allow get: if true; 
        allow list: if isCompanyMember(companyId);
        allow write: if isCompanyMember(companyId);
      }

      match /workOrders/{workOrderId} {
        // El cliente debe poder ver su OT sin loguearse
        allow get: if true; 
        allow list: if isCompanyMember(companyId);
        // Permitir creación inicial (desde API/Portal)
        allow create: if isCompanyMember(companyId) || (request.resource.data.status == 'solicitada');
        // Aprobación del cliente: Permitir actualización si la OT está en estados interactivos
        allow update: if isCompanyMember(companyId) || isSignedIn() || 
                     (resource.data.status == 'pendiente cliente') || 
                     (resource.data.status == 'en revision') ||
                     (resource.data.status == 'ejecutada');
        
        match /digitalLogbookEntries/{entryId} {
          allow read, write: if true; // Bitácora siempre accesible para trazabilidad
        }
        
        match /partUsages/{usageId} {
          allow read, write: if isCompanyMember(companyId);
        }
      }
      
      match /assets/{assetId} {
        // El portal muestra el equipo intervenido
        allow get: if true;
        allow list, write: if isCompanyMember(companyId);
      }

      match /evaluations/{evalId} {
        // El cliente debe poder enviar su evaluación de satisfacción
        allow create: if true; 
        allow read, update: if isCompanyMember(companyId);
      }
      
      // Resto de subcolecciones protegidas por membresía de empresa
      match /{allSub=**} {
        allow read, write: if isCompanyMember(companyId);
      }
    }

    // --- REGLAS DE USUARIOS (SOPORTE TOTAL PARA LOGIN Y REGISTRO) ---

    match /users/{userId} {
      allow get, list, create, update: if true;
      allow delete: if isPlatformAdmin();
    }

    match /platform_admins/{adminId} {
      allow get: if isSignedIn();
      allow list: if isPlatformAdmin();
    }

    match /supportTickets/{ticketId} {
      allow get, update, list, create: if isSignedIn();

      match /messages/{messageId} {
        allow read, write: if isSignedIn();
      }
    }

    match /mail/{mailId} {
      allow read, write: if isSignedIn();
    }
  }
}
