
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * PCGMANTENIMIENTO SECURITY RULES - SaaS Edition
     * Optimizadas para Onboarding y Trazabilidad Industrial
     */

    // --- Funciones de Ayuda ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isPlatformAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/platform_admins/$(request.auth.uid));
    }

    function getUserData() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data : null;
    }

    function isCompanyMember(companyId) {
      let userData = getUserData();
      return isSignedIn() && (isPlatformAdmin() || (userData != null && userData.companyId == companyId));
    }

    function hasRole(role) {
      let userData = getUserData();
      return isSignedIn() && (isPlatformAdmin() || (userData != null && userData.role == role));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Reglas de Colección ---

    match /users/{userId} {
      allow get: if isSignedIn(); // Permitir lectura de perfiles para validación de login/session
      // Permitir listado limitado para el login de técnicos por RUT
      allow list: if isPlatformAdmin() || isSignedIn() || (request.query.limit <= 5);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isPlatformAdmin();
      allow delete: if isPlatformAdmin();
    }

    match /platform_admins/{adminId} {
      allow get: if isSignedIn();
      allow list: if isPlatformAdmin();
    }

    match /companies/{companyId} {
      allow get: if true;
      allow list: if isPlatformAdmin() || isSignedIn();
      // Permitir creación si el usuario está autenticado (Onboarding SaaS)
      // O actualización si es administrador de la empresa
      allow write: if isSignedIn() && (resource == null || isPlatformAdmin() || (isCompanyMember(companyId) && hasRole('companyAdmin')));
      allow delete: if isPlatformAdmin();

      match /staff/{staffId} {
        allow get: if true;
        allow list: if isCompanyMember(companyId);
        // Permitir actualización del registro de staff durante el setup inicial del técnico
        allow write: if isCompanyMember(companyId) || (isSignedIn() && request.resource.data.userId == request.auth.uid);
      }

      match /teams/{teamId} {
        allow read, write: if isCompanyMember(companyId);
      }

      match /clients/{clientId} {
        allow get: if true;
        allow list: if isCompanyMember(companyId);
        allow write: if isCompanyMember(companyId);
      }

      match /assets/{assetId} {
        allow get: if true;
        allow list: if isCompanyMember(companyId);
        allow write: if isCompanyMember(companyId);
      }

      match /spareParts/{partId} {
        allow read, write: if isCompanyMember(companyId);
      }

      match /evaluations/{evalId} {
        allow read: if isCompanyMember(companyId);
        allow create: if true; 
      }

      match /workOrders/{workOrderId} {
        allow create: if isCompanyMember(companyId) || (request.resource.data.status == 'solicitada');
        allow get: if true; 
        allow list: if isCompanyMember(companyId);
        allow update: if isCompanyMember(companyId) || (resource.data.status == 'pendiente cliente'); 
        allow delete: if isCompanyMember(companyId) && (hasRole('companyAdmin') || hasRole('supervisor'));

        match /digitalLogbookEntries/{entryId} {
          allow read, write: if isCompanyMember(companyId);
        }
        
        match /partUsages/{usageId} {
          allow read, write: if isCompanyMember(companyId);
        }
      }
    }

    match /supportTickets/{ticketId} {
      allow get, update: if isSignedIn() && (isPlatformAdmin() || resource.data.userId == request.auth.uid || isCompanyMember(resource.data.companyId));
      allow list: if isPlatformAdmin() || (isSignedIn() && (resource == null || resource.data.companyId == getUserData().companyId));
      allow create: if isSignedIn();

      match /messages/{messageId} {
        allow read, write: if isSignedIn();
      }
    }

    match /mail/{mailId} {
      allow read, write: if isPlatformAdmin() || isSignedIn();
    }
  }
}
