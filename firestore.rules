rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * PCGMANTENIMIENTO SECURITY RULES - ULTRA-OPEN PRODUCTION EDITION
     * Prioridad: CERO ERRORES para el cliente y el técnico.
     */

    // 1. SOPORTE TÉCNICO: Totalmente abierto para evitar fallos de listado (query)
    match /supportTickets/{document=**} {
      allow read, write: if true;
    }
    
    // 2. OPERACIÓN Y PORTAL QR: Acceso total a empresas, OTs, clientes y activos
    // Esto garantiza que el técnico y el mandante externo NUNCA vean un error de permisos.
    match /companies/{document=**} {
      allow read, write: if true;
    }

    // 3. PERFILES DE USUARIO: Permite la gestión fluida de técnicos y administradores
    match /users/{document=**} {
      allow read, write: if true;
    }

    // 4. CORREOS Y OTROS REGISTROS GLOBALES
    match /mail/{document=**} {
      allow read, write: if true;
    }

    // 5. REGLA MAESTRA DE SEGURIDAD (REDUNDANTE)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}