
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- FUNCIONES HELPER ---
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isSuperAdmin() {
      if (!isSignedIn()) return false;
      // Verificación directa en la colección privilegiada
      return exists(/databases/$(database)/documents/superAdmins/$(request.auth.uid));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isCompanyMember(companyId) {
      if (!isSignedIn()) return false;
      if (isSuperAdmin()) return true;
      
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(userPath) && get(userPath).data.companyId == companyId;
    }

    // --- REGLAS DE COLECCIONES ---

    match /superAdmins/{userId} {
      // Permitir creación si es el propio usuario (necesario para el registro inicial)
      allow create: if isOwner(userId);
      allow read: if isOwner(userId) || isSuperAdmin();
    }

    match /users/{userId} {
      // Permitir creación y edición del propio perfil
      allow create: if isOwner(userId);
      allow get: if isSignedIn();
      allow list: if isSignedIn() && isSuperAdmin();
      allow update: if isOwner(userId) || isSuperAdmin();
    }

    match /companies/{companyId} {
      // Permitir creación inicial de la empresa por cualquier usuario autenticado
      allow create: if isSignedIn();
      allow get: if isSignedIn() && (isSuperAdmin() || isCompanyMember(companyId));
      allow list: if isSuperAdmin();
      allow update: if isSuperAdmin() || isCompanyMember(companyId);

      // Regla comodín para subcolecciones de empresa
      match /{allPaths=**} {
        allow read: if isSignedIn() && (isSuperAdmin() || isCompanyMember(companyId));
        allow write: if isSignedIn() && (isSuperAdmin() || isCompanyMember(companyId));
      }
    }
  }
}
