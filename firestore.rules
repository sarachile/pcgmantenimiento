rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * PCGMANTENIMIENTO SECURITY RULES - Zero-Friction Edition
     * Permiso universal de lectura y escritura para garantizar la operatividad de la API, 
     * portales públicos y técnicos en terreno.
     */
    match /{document=**} {
      allow read, write: if true;
    }
  }
}