
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * PCGMANTENIMIENTO SECURITY RULES
     * Implementación SaaS con soporte para Portal de Validación Externo (Público)
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isPlatformAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/platform_admins/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isCompanyMember(companyId) {
      return isSignedIn() && (isPlatformAdmin() || getUserData().companyId == companyId);
    }

    function hasRole(role) {
      return isSignedIn() && (isPlatformAdmin() || getUserData().role == role);
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Collection Rules ---

    match /platform_admins/{userId} {
      allow get: if isOwner(userId) || isPlatformAdmin();
      allow list: if isPlatformAdmin();
      allow create, update, delete: if false; 
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isPlatformAdmin();
      allow list: if isPlatformAdmin() || (isSignedIn() && getUserData().companyId != null);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isPlatformAdmin();
      allow delete: if isPlatformAdmin();
    }

    match /companies/{companyId} {
      // Allow public get for the customer portal branding
      allow get: if isCompanyMember(companyId) || true;
      allow list: if isPlatformAdmin();
      allow create: if isPlatformAdmin();
      allow update: if isPlatformAdmin() || (isCompanyMember(companyId) && hasRole('companyAdmin'));
      allow delete: if isPlatformAdmin();

      match /staff/{staffId} {
        allow read, write: if isCompanyMember(companyId);
      }

      match /clients/{clientId} {
        // Public get for portal info
        allow get: if isCompanyMember(companyId) || true;
        allow list: if isCompanyMember(companyId);
        allow write: if isCompanyMember(companyId);
      }

      match /assets/{assetId} {
        // Public get for portal info
        allow get: if isCompanyMember(companyId) || true;
        allow list: if isCompanyMember(companyId);
        allow write: if isCompanyMember(companyId);
      }

      match /evaluations/{evalId} {
        allow read: if isCompanyMember(companyId);
        // Clients can create evaluations without login from the portal
        allow create: if true; 
      }

      match /workOrders/{workOrderId} {
        // Public get for portal validation (ID acts as a secret token)
        allow get: if true; 
        allow list: if isCompanyMember(companyId);
        allow create: if isCompanyMember(companyId);
        // Clients can update status/signature from portal
        allow update: if isCompanyMember(companyId) || (resource.data.status == 'pendiente cliente'); 
        allow delete: if isCompanyMember(companyId);
        
        match /digitalLogbookEntries/{entryId} {
          allow read: if isCompanyMember(companyId) || true;
          allow write: if isCompanyMember(companyId);
        }
        match /partUsages/{usageId} {
          allow read: if isCompanyMember(companyId) || true;
          allow write: if isCompanyMember(companyId);
        }
      }
    }

    match /mail/{mailId} {
      allow read, write: if isPlatformAdmin() || isSignedIn();
    }
  }
}
