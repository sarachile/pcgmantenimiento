
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- FUNCIONES HELPER ---
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isSuperAdmin() {
      if (!isSignedIn()) return false;
      return exists(/databases/$(database)/documents/superAdmins/$(request.auth.uid));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isCompanyMember(companyId) {
      if (!isSignedIn()) return false;
      if (isSuperAdmin()) return true;
      
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(userPath) && get(userPath).data.companyId == companyId;
    }

    // --- REGLAS DE COLECCIONES ---

    match /superAdmins/{userId} {
      // Permitir creación inicial si es el propio usuario
      allow create: if isOwner(userId);
      allow read: if isOwner(userId) || isSuperAdmin();
      allow update, delete: if isSuperAdmin();
    }

    match /users/{userId} {
      // Permitir creación inicial si es el propio usuario
      allow create: if isOwner(userId);
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow update: if isOwner(userId) || isSuperAdmin();
    }

    match /companies/{companyId} {
      // Permitir creación inicial por cualquier usuario autenticado (fase de registro)
      allow create: if isSignedIn();
      
      // Permitir lectura y actualización si es miembro o superadmin
      allow read: if isSignedIn() && (isSuperAdmin() || isCompanyMember(companyId));
      allow update: if isSignedIn() && (isSuperAdmin() || isCompanyMember(companyId));
      allow list: if isSuperAdmin();

      // Regla para subcolecciones de empresa (clientes, activos, OTs, etc.)
      match /{allPaths=**} {
        allow read, write: if isSignedIn() && (isSuperAdmin() || isCompanyMember(companyId));
      }
    }
  }
}
