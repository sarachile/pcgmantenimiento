
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // 🔧 HELPERS
    // =========================

    function isSignedIn() {
      return request.auth != null;
    }

    function userDocRef() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userExists() {
      return exists(userDocRef());
    }

    function getUserData() {
      return userExists() ? get(userDocRef()).data : null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'control@pcgoperacion.com' ||
        exists(/databases/$(database)/documents/superAdmins/$(request.auth.uid)) ||
        (userExists() && getUserData().role == 'superadmin')
      );
    }

    function isCompanyMember(companyId) {
      return isSignedIn() &&
        (
          isSuperAdmin() || 
          (userExists() && getUserData().companyId == companyId)
        );
    }

    function hasRole(companyId, roles) {
      return isSignedIn() &&
        (
          isSuperAdmin() ||
          (userExists() && getUserData().companyId == companyId && getUserData().role in roles)
        );
    }

    // =========================
    // 📧 MAIL (SERVER ACTIONS)
    // =========================

    match /mail/{mailId} {
      allow read: if isSuperAdmin();
      allow create, update: if isSignedIn();
    }

    // =========================
    // 👤 USERS (ACCESO SISTEMA)
    // =========================

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if true; 
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSuperAdmin();
    }

    match /superAdmins/{userId} {
      allow read, write: if isSuperAdmin();
    }

    // =========================
    // 🏢 COMPANIES
    // =========================

    match /companies/{companyId} {
      allow get: if true; 
      allow list: if isSuperAdmin();
      allow create, update, delete: if isSuperAdmin();

      // ---------- STAFF (PERSONAL OPERATIVO) ----------
      match /staff/{staffId} {
        allow read: if isCompanyMember(companyId);
        allow write: if hasRole(companyId, ['companyAdmin', 'supervisor']);
      }

      // ---------- CLIENTS ----------
      match /clients/{clientId} {
        allow read: if isCompanyMember(companyId);
        allow write: if hasRole(companyId, ['companyAdmin', 'supervisor']);
      }

      // ---------- ASSETS ----------
      match /assets/{assetId} {
        allow read: if isCompanyMember(companyId);
        allow write: if hasRole(companyId, ['companyAdmin', 'supervisor', 'tecnico']);
      }

      // ---------- WORK ORDERS ----------
      match /workOrders/{workOrderId} {
        allow list, get: if isCompanyMember(companyId);
        allow create, update: if hasRole(companyId, ['companyAdmin', 'supervisor', 'tecnico']);
        allow delete: if hasRole(companyId, ['companyAdmin']);

        match /partUsages/{usageId} { allow read, write: if isCompanyMember(companyId); }
        match /digitalLogbookEntries/{entryId} { allow read, write: if isCompanyMember(companyId); }
      }

      // ---------- SPARE PARTS ----------
      match /spareParts/{partId} {
        allow read, write: if isCompanyMember(companyId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
