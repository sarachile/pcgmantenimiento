
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * PCGMANTENIMIENTO SECURITY RULES - SaaS Edition
     * MAX FLEXIBILITY FOR ONBOARDING & TECH ACCESS
     */

    // --- Funciones de Ayuda ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isPlatformAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/platform_admins/$(request.auth.uid));
    }

    function getUserData() {
      if (!isSignedIn()) {
        return null;
      }
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data : null;
    }

    function isCompanyMember(companyId) {
      if (isPlatformAdmin()) { return true; }
      let userData = getUserData();
      return isSignedIn() && userData != null && userData.companyId == companyId;
    }

    // --- REGLAS DE ACCESO PÚBLICO (PARA INVITACIONES Y PORTALES) ---
    
    match /companies/{companyId} {
      // Lectura pública para branding en portales e invitaciones
      allow get: if true;
      allow list: if isSignedIn();

      match /staff/{staffId} {
        // FLEXIBILIZADO: Permitir que el técnico se valide y actualice su estado de cuenta
        allow get, write: if true; 
        allow list: if isCompanyMember(companyId);
      }

      match /clients/{clientId} {
        allow get: if true;
        allow list: if isCompanyMember(companyId);
        allow write: if isCompanyMember(companyId);
      }

      match /workOrders/{workOrderId} {
        allow get: if true;
        allow list: if isCompanyMember(companyId);
        allow create: if isCompanyMember(companyId) || (request.resource.data.status == 'solicitada');
        allow update: if isCompanyMember(companyId) || isSignedIn() || (resource.data.status == 'pendiente cliente');
        
        match /digitalLogbookEntries/{entryId} {
          allow read, write: if true; // Permitir logs desde portal público
        }
        
        match /partUsages/{usageId} {
          allow read, write: if isCompanyMember(companyId);
        }
      }
      
      match /assets/{assetId} {
        allow get: if true;
        allow list, write: if isCompanyMember(companyId);
      }

      match /evaluations/{evalId} {
        allow create: if true;
        allow read, write: if isCompanyMember(companyId);
      }
      
      // Resto de subcolecciones protegidas
      match /{allSub=**} {
        allow read, write: if isCompanyMember(companyId);
      }
    }

    // --- REGLAS DE USUARIOS (SOPORTE PARA LOGIN Y REGISTRO) ---

    match /users/{userId} {
      // FLEXIBILIZADO: Permitir lectura, creación y actualización para procesos de onboarding
      allow get, list, create, update: if true;
      allow delete: if isPlatformAdmin();
    }

    match /platform_admins/{adminId} {
      allow get: if isSignedIn();
      allow list: if isPlatformAdmin();
    }

    match /supportTickets/{ticketId} {
      allow get, update, list, create: if isSignedIn();

      match /messages/{messageId} {
        allow read, write: if isSignedIn();
      }
    }

    match /mail/{mailId} {
      allow read, write: if isSignedIn();
    }
  }
}
