rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * PCGMANTENIMIENTO SECURITY RULES
     * 
     * Implementación de modelo SaaS con validación centralizada en la colección /users.
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isPlatformAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/platform_admins/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isCompanyMember(companyId) {
      return isSignedIn() && (isPlatformAdmin() || getUserData().companyId == companyId);
    }

    function hasRole(role) {
      return isSignedIn() && (isPlatformAdmin() || getUserData().role == role);
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Collection Rules ---

    match /platform_admins/{userId} {
      allow get: if isOwner(userId) || isPlatformAdmin();
      allow list: if isPlatformAdmin();
      allow create, update, delete: if false; 
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isPlatformAdmin();
      allow list: if isPlatformAdmin() || (isSignedIn() && getUserData().companyId != null);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isPlatformAdmin();
      allow delete: if isPlatformAdmin();
    }

    match /companies/{companyId} {
      allow get: if isCompanyMember(companyId);
      allow list: if isPlatformAdmin();
      allow create: if isPlatformAdmin();
      allow update: if isPlatformAdmin() || (isCompanyMember(companyId) && hasRole('companyAdmin'));
      allow delete: if isPlatformAdmin();
    }

    match /companies/{companyId}/staff/{staffId} {
      allow read, write: if isCompanyMember(companyId);
    }

    match /companies/{companyId}/clients/{clientId} {
      allow read, write: if isCompanyMember(companyId);
    }

    match /companies/{companyId}/assets/{assetId} {
      allow read, write: if isCompanyMember(companyId);
    }

    match /companies/{companyId}/spareParts/{partId} {
      allow read, write: if isCompanyMember(companyId);
    }

    match /companies/{companyId}/workOrders/{workOrderId} {
      allow read, write: if isCompanyMember(companyId);
      
      match /digitalLogbookEntries/{entryId} {
        allow read, write: if isCompanyMember(companyId);
      }
      match /partUsages/{usageId} {
        allow read, write: if isCompanyMember(companyId);
      }
    }

    match /companies/{companyId}/evaluations/{evalId} {
      allow read, write: if isCompanyMember(companyId);
    }

    match /mail/{mailId} {
      allow read, write: if isPlatformAdmin();
    }
  }
}