/**
 * PCGMANTENIMIENTO ERP - Security Rules Architecture
 *
 * CORE PHILOSOPHY:
 * This ruleset implements a strict multi-tenant (multi-company) isolation model. Access is 
 * partitioned by 'companyId' at the root level. All authorization decisions rely on 
 * the user's role and company affiliation stored within Firestore.
 *
 * DATA STRUCTURE:
 * - /companies/{companyId}: Root tenant isolation.
 * - /superAdmins/{userId}: Platform-level administrators.
 * - /companies/{companyId}/users/{userId}: Tenant-specific users and roles.
 * - /companies/{companyId}/workOrders/...: Operational data nested under the company.
 *
 * KEY SECURITY DECISIONS:
 * 1. Multi-Tenancy: Access to any data under /companies/{companyId} requires the user to 
 *    have a corresponding record in /companies/{companyId}/users/{request.auth.uid}.
 * 2. Role-Based Access Control (RBAC): Within a company, access is further refined by 
 *    roles: 'companyAdmin', 'supervisor', 'tecnico', and 'reviewer'.
 * 3. Immutability: Digital Logbook entries are write-once (create only) to preserve 
 *    audit trail integrity.
 * 4. Superadmin Override: Users defined in the global /superAdmins collection have 
 *    unrestricted platform-wide access.
 *
 * DENORMALIZATION FOR AUTHORIZATION:
 * - Documents include 'companyId' and 'workOrderId' internally to allow rules to verify 
 *   path consistency and ownership without recursive parent lookups where possible.
 */

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- GLOBAL HELPER FUNCTIONS ---

    /** @description Checks if the request is from an authenticated user. */
    function isSignedIn() {
      return request.auth != null;
    }

    /** @description Checks if the user is a global platform SuperAdmin. */
    function isSuperAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/superAdmins/$(request.auth.uid));
    }

    /** @description Retrieves the user's document within a specific company. */
    function getCompanyUserData(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId)/users/$(request.auth.uid)).data;
    }

    /** @description Checks if the user belongs to the specified company. */
    function isCompanyMember(companyId) {
      return isSignedIn() && exists(/databases/$(database)/documents/companies/$(companyId)/users/$(request.auth.uid));
    }

    /** @description Checks if the user has one of the allowed roles within a company. */
    function hasAnyRole(companyId, roles) {
      return isCompanyMember(companyId) && getCompanyUserData(companyId).role in roles;
    }

    /** @description Validates that the resource exists and the user is a company member. */
    function isExistingMember(companyId) {
      return resource != null && isCompanyMember(companyId);
    }

    // --- COLLECTION RULES ---

    /**
     * @description Platform-wide super-administrator registry.
     * @path /superAdmins/{userId}
     * @allow (get) Any signed-in user can check existence. (write) Only existing superadmins.
     * @deny Any write by non-superadmins.
     */
    match /superAdmins/{userId} {
      allow get: if isSignedIn();
      allow list: if isSuperAdmin();
      allow create, update, delete: if isSuperAdmin();
      
      /** 
       * NOTE: Bootstrap of the first superadmin must be done via Admin SDK 
       * or Firebase Console as rules prevent self-promotion. 
       */
    }

    /**
     * @description Top-level Company (Tenant) documents.
     * @path /companies/{companyId}
     * @allow (read) Members of the company or superadmins. (write) Superadmins only.
     * @deny Updates to company data by regular company users.
     * @principle Structural segregation by tenant.
     */
    match /companies/{companyId} {
      allow get: if isSuperAdmin() || isCompanyMember(companyId);
      allow list: if isSuperAdmin();
      allow create, update, delete: if isSuperAdmin();

      /**
       * @description Company-specific users and their assigned roles.
       * @path /companies/{companyId}/users/{userId}
       * @allow (read) Any company member. (create/update) CompanyAdmin or SuperAdmin.
       * @deny Users changing their own roles or accessing other companies.
       */
      match /users/{userId} {
        allow get, list: if isSuperAdmin() || isCompanyMember(companyId);
        allow create: if isSuperAdmin() || (hasAnyRole(companyId, ['companyAdmin']) && request.resource.data.id == userId);
        allow update: if isSuperAdmin() || (resource != null && hasAnyRole(companyId, ['companyAdmin']));
        allow delete: if isSuperAdmin() || (resource != null && hasAnyRole(companyId, ['companyAdmin']));
      }

      /**
       * @description Subscription and billing details for the company.
       * @path /companies/{companyId}/subscriptions/{subscriptionId}
       * @allow (read) CompanyAdmin or SuperAdmin. (write) SuperAdmin only.
       * @deny Regular technicians or supervisors viewing billing data.
       */
      match /subscriptions/{subscriptionId} {
        allow get, list: if isSuperAdmin() || hasAnyRole(companyId, ['companyAdmin']);
        allow create, update, delete: if isSuperAdmin();
      }

      /**
       * @description Work Orders managed by the company.
       * @path /companies/{companyId}/workOrders/{workOrderId}
       * @allow (read) Any company member. (write) Admin, Supervisor, or assigned Technician.
       * @deny Access to members of different companies.
       * @principle Relational integrity via companyId path.
       */
      match /workOrders/{workOrderId} {
        allow get, list: if isSuperAdmin() || isCompanyMember(companyId);
        allow create: if isSuperAdmin() || (hasAnyRole(companyId, ['companyAdmin', 'supervisor', 'tecnico']) && request.resource.data.companyId == companyId);
        allow update: if isSuperAdmin() || (isExistingMember(companyId) && hasAnyRole(companyId, ['companyAdmin', 'supervisor', 'tecnico', 'reviewer']));
        allow delete: if isSuperAdmin() || (isExistingMember(companyId) && hasAnyRole(companyId, ['companyAdmin']));

        /**
         * @description Immutable Digital Logbook entries for auditing.
         * @path /companies/{companyId}/workOrders/{workOrderId}/digitalLogbookEntries/{entryId}
         * @allow (read) Any company member. (create) Any company member performing an action.
         * @deny (update/delete) Explicitly forbidden to ensure audit integrity.
         */
        match /digitalLogbookEntries/{entryId} {
          allow get, list: if isSuperAdmin() || isCompanyMember(companyId);
          allow create: if isSuperAdmin() || (isCompanyMember(companyId) && request.resource.data.companyId == companyId && request.resource.data.workOrderId == workOrderId);
          allow update, delete: if false; // Audit trail is immutable
        }

        /**
         * @description Formal reviews of a Work Order.
         * @path /companies/{companyId}/workOrders/{workOrderId}/reviews/{reviewId}
         * @allow (read) Any company member. (write) Reviewers, Supervisors, or Admins.
         * @deny Technicians approving their own work reviews.
         */
        match /reviews/{reviewId} {
          allow get, list: if isSuperAdmin() || isCompanyMember(companyId);
          allow create: if isSuperAdmin() || (hasAnyRole(companyId, ['companyAdmin', 'supervisor', 'reviewer']) && request.resource.data.companyId == companyId);
          allow update: if isSuperAdmin() || (isExistingMember(companyId) && hasAnyRole(companyId, ['companyAdmin', 'supervisor', 'reviewer']));
          allow delete: if isSuperAdmin() || (isExistingMember(companyId) && hasAnyRole(companyId, ['companyAdmin']));
        }
      }
    }
  }
}