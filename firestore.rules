
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- FUNCIONES HELPER ---
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isSuperAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/superAdmins/$(request.auth.uid));
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function getCompanyUser(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId)/users/$(request.auth.uid)).data;
    }

    function isCompanyMember(companyId) {
      let globalUser = getUserData();
      return isSignedIn() && (globalUser.companyId == companyId || isSuperAdmin());
    }

    function hasRole(companyId, roles) {
      let companyUser = getCompanyUser(companyId);
      return isSignedIn() && (companyUser.role in roles || isSuperAdmin());
    }

    // --- REGLAS ---

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
    }

    match /superAdmins/{userId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /companies/{companyId} {
      allow get: if isCompanyMember(companyId);
      allow list: if isSuperAdmin();
      allow create, update: if isSuperAdmin();

      match /assets/{assetId} {
        allow read: if isCompanyMember(companyId);
        allow create, delete: if hasRole(companyId, ['companyAdmin', 'supervisor']);
        allow update: if hasRole(companyId, ['companyAdmin', 'supervisor', 'tecnico']);
      }

      match /spareParts/{partId} {
        allow read: if isCompanyMember(companyId);
        allow create, delete: if hasRole(companyId, ['companyAdmin', 'supervisor']);
        allow update: if hasRole(companyId, ['companyAdmin', 'supervisor', 'tecnico']);
      }

      match /users/{userId} {
        allow read: if isCompanyMember(companyId);
        allow write: if isSuperAdmin() || (hasRole(companyId, ['companyAdmin']) && request.auth.uid != userId);
      }

      match /workOrders/{workOrderId} {
        allow list: if isCompanyMember(companyId);
        
        allow get: if isCompanyMember(companyId) && (
          hasRole(companyId, ['companyAdmin', 'supervisor', 'tecnico']) ||
          (hasRole(companyId, ['reviewer']) && resource.data.reviewerId == request.auth.uid)
        );

        allow create: if hasRole(companyId, ['companyAdmin', 'supervisor']);

        allow update: if isCompanyMember(companyId) && (
          hasRole(companyId, ['companyAdmin', 'supervisor']) ||
          (hasRole(companyId, ['tecnico']) && 
           resource.data.assignedToUserId == request.auth.uid && 
           request.resource.data.status != 'aprobada') ||
          (hasRole(companyId, ['reviewer']) && 
           resource.data.reviewerId == request.auth.uid)
        );

        match /partUsages/{usageId} {
          allow read: if isCompanyMember(companyId);
          allow create: if isCompanyMember(companyId) && (
            hasRole(companyId, ['companyAdmin', 'supervisor']) ||
            (hasRole(companyId, ['tecnico']) && get(/databases/$(database)/documents/companies/$(companyId)/workOrders/$(workOrderId)).data.assignedToUserId == request.auth.uid)
          );
          allow update, delete: if hasRole(companyId, ['companyAdmin', 'supervisor']);
        }

        match /digitalLogbookEntries/{entryId} {
          allow read: if isCompanyMember(companyId);
          allow create: if isCompanyMember(companyId) && 
                         request.resource.data.actorUserId == request.auth.uid;
          allow update, delete: if false; 
        }

        match /reviews/{reviewId} {
          allow read: if isCompanyMember(companyId);
          allow create, update: if isCompanyMember(companyId) && 
                                 (hasRole(companyId, ['reviewer', 'supervisor', 'companyAdmin']));
        }

        match /invoices/{invoiceId} {
          allow read: if isCompanyMember(companyId);
          allow create: if hasRole(companyId, ['companyAdmin', 'supervisor']) && 
                        get(/databases/$(database)/documents/companies/$(companyId)/workOrders/$(workOrderId)).data.status == 'aprobada';
          allow update: if isSuperAdmin(); // Solo el sistema o superadmin actualiza folios/estados SII
          allow delete: if false;
        }
      }
      
      match /subscriptions/{subId} {
        allow read: if isCompanyMember(companyId);
        allow write: if isSuperAdmin();
      }
    }
  }
}
