
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * MODO DE EMERGENCIA - PRODUCCIÓN TOTAL
     * Se habilita acceso total para evitar bloqueos en el Centro de Soporte, 
     * Portal QR, Gestión de Personal y Operaciones.
     */
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
