rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * PCGMANTENIMIENTO SECURITY RULES - Secure Production Edition
     * Permite lectura y escritura a usuarios autenticados para mantener la fluidez operativa.
     * El portal de aprobación del cliente requiere acceso para usuarios logueados.
     */
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}